{
  "expo": {
    "name": "Safe Delivery Rider",
    "slug": "safe-delivery-rider",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F4B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.safedelivery.rider",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is needed to capture selfie verification and delivery proof photos.",
        "NSLocationWhenInUseUsageDescription": "Location is needed to share live position with customers during deliveries.",
        "NSPhotoLibraryUsageDescription": "Photo library access needed for uploading KYC documents."
      }
    },
    "android": {
      "package": "com.safedelivery.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F4B"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Safe Delivery to access camera for selfie and delivery photos." }],
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Allow Safe Delivery to use location to share with customers during deliveries." }],
      ["expo-image-picker", { "photosPermission": "Allow Safe Delivery to access photos for KYC documents." }],
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B4FD8",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Safe Delivery Rider",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "kotlinVersion": "2.1.21"
          }
        }
      ]
    ],
    "sdkVersion": "54.0.0"
  }
}